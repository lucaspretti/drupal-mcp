# Drupal MCP Server Configuration
# Copy this file to .env and fill in your values, then `node drupal-mcp.js`.

# Base URL of your Drupal site (no trailing slash). Required.
DRUPAL_BASE_URL=https://example.com

# Drupal account used for API calls. Should be a dedicated bot user
# with the minimal role needed for what you want to do (e.g. only the
# article + page bundles, no admin). Required.
DRUPAL_USER=mcp_bot

# Password for that user. Required.
DRUPAL_PASSWORD=change-me

# Optional. JSON:API URL prefix (default: /jsonapi). Override only if
# your site mounts JSON:API somewhere else (rare).
# DRUPAL_JSONAPI_PREFIX=/jsonapi

# Optional. Request timeout in ms (default: 30000).
# REQUEST_TIMEOUT=30000
